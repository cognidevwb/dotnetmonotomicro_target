root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# this. qualification + predefined types
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# var preferences (Microsoft default: explicit type; var when apparent)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# modern idioms
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_namespace_match_folder = true:suggestion

# naming: private/internal fields _camelCase, constants PascalCase
dotnet_naming_rule.private_internal_fields_underscore.severity = warning
dotnet_naming_rule.private_internal_fields_underscore.symbols = private_internal_fields
dotnet_naming_rule.private_internal_fields_underscore.style = camel_case_underscore_style
dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

# Meziantou.Analyzer — keep as IDE hints, NOT build-breakers. With
# TreatWarningsAsErrors=true these style rules otherwise fail the build on
# generated code (they even fail the scaffold's OWN output). Correctness rules
# (compiler CS*, .NET CA*) stay errors; only the pedantic style ones relax.
# MA0004: ConfigureAwait(false) — a NO-OP in ASP.NET Core (no SynchronizationContext).
dotnet_diagnostic.MA0004.severity = none
# MA0048: one public type per file / filename must match — we DELIBERATELY group
# Request + Response + Validator (+ small result enums) per feature slice.
dotnet_diagnostic.MA0048.severity = none
# MA0051: method length — generated handlers are legitimately long.
dotnet_diagnostic.MA0051.severity = suggestion
# MA0016: prefer returning a collection abstraction — style, not correctness.
dotnet_diagnostic.MA0016.severity = suggestion

[*.{Designer,g,g.i}.cs]
generated_code = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2
