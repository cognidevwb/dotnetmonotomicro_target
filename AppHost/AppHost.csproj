<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <IsFrameworkProject>true</IsFrameworkProject>
    <UserSecretsId>apphost-acmeplatform</UserSecretsId>
    <!-- Aspire hosting APIs surface experimental-API diagnostics; the AppHost is infra
         glue, so don't fail its build on them. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <!-- Azure-first: provisions Azure resources on `aspire deploy`/`aspire publish`, runs local containers/emulators in dev. -->
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../services/catalog/Catalog.csproj" />
    <ProjectReference Include="../services/customers/Customers.csproj" />
    <ProjectReference Include="../services/payments/Payments.csproj" />
    <ProjectReference Include="../services/orders/Orders.csproj" />
  </ItemGroup>
</Project>
